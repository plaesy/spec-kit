{
  "name": "spec-kit",
  "version": "1.0.0",
  "description": "Business validation pipeline: niche -> idea -> validation -> make money verdict",
  "author": { "name": "Mahbub Zulkarnain" },
  "license": "MIT",
  "repository": "https://github.com/plaesy/spec-kit",
  "keywords": ["business", "validation", "startup", "pipeline", "youtube", "automation", "skills"],
  "skills": "./skills/",
  "hooks": {
    "pre-stage": "scripts/pre_stage_hook.py",
    "post-stage": "scripts/post_stage_hook.py",
    "pre-pipeline": "scripts/pre_pipeline_hook.py",
    "post-pipeline": "scripts/post_pipeline_hook.py"
  },
  "entry_points": {
    "ideator": "skills/ideator/main.py",
    "buyer-discovery": "skills/buyer-discovery/main.py",
    "compliance-health": "skills/compliance-health/main.py",
    "economics-engine": "skills/economics-engine/main.py",
    "plan-compiler": "skills/plan-compiler/main.py",
    "assess": "skills/assess/main.py",
    "pipeline": "skills/pipeline/main.py",
    "youtube-automation": "skills/youtube-automation/main.py"
  },
  "tools": [
    "web_search",
    "bash",
    "file_read",
    "file_write",
    "json_parse"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "default_niche": {"type": "string"},
      "default_budget": {"type": "number"},
      "default_timeline": {"type": "string"},
      "web_search_backend": {"type": "string", "enum": ["exa", "jina", "serpapi", "duckduckgo"]},
      "llm_provider": {"type": "string", "enum": ["gemini", "groq", "openrouter", "pollinations"]},
      "enable_youtube": {"type": "boolean", "default": false}
    }
  },
  "interface": {
    "displayName": "Spec-Kit Business Validation",
    "shortDescription": "Niche -> Idea -> Validation -> Make Money pipeline with YouTube automation",
    "category": "Business",
    "capabilities": ["Interactive", "Read", "Write"],
    "defaultPrompt": ["Run the full spec-kit pipeline for my niche."]
  },
  "minimum_codex_version": "2.0.0"
}