{
  "description": "Mapping of technology keywords to instruction files for auto-loading context-aware instructions",
  "version": "1.0.0",
  "excluded_files_note": "instructions/agents.instructions.md is intentionally NOT referenced anywhere in this file. It's the platform 'core' template (scripts/configs/platform.json → mapping.core.value), copied per chosen AI platform as CLAUDE.md, AGENTS.md, .cursor/rules/plaesy.mdc, etc. by `plaesy init`'s platform-specific setup (see scripts/internal/scaffold/platform.go:SetupPlatformConfig) — not by the generic instructions copy or detect-stack selection this file drives. platform.json's mapping.instructions.excludes already excludes it from the generic copy for the same reason. Do not add it to 'always_load' or any category here.",
  "field_semantics_note": "Verified against scripts/internal/detectstack/detectstack.go (Go port, single cross-platform implementation replacing the old scripts/bash/detect-stack.sh + scripts/powershell/detect-stack.ps1 pair as of 2026-09): only 'file', 'keywords', 'extensions', and 'filenames' are actually read to decide what loads. 'extensions' matches any file with that suffix anywhere under the target (existence-only, e.g. '.docx'); 'filenames' matches an exact filename anywhere under the target (existence-only, e.g. 'next.config.js') — use 'filenames' instead of a keyword when the only reliable signal is a specific config file's name, not its content (a bare dependency name like \"next\" is too generic/prose-colliding to add as a keyword). Do not put literal double-quote characters inside a 'keywords' entry unless you have re-checked detect-stack.go's keyword extraction handles escaping the way you expect. 'patterns' and 'triggers' (per entry) and this file's top-level 'description'/'version' plus 'detection_rules.priority'/'case_insensitive'/'deduplication' are NOT read by the Go implementation — they are documentation/intent only. 'case_insensitive' and 'deduplication' happen to already match real behavior (matching is case-insensitive and output is deduplicated) but are not switches — flipping them here changes nothing. Do not assume editing 'patterns', 'triggers', or 'priority' affects detection; if you need pattern- or trigger-based matching to actually run, it must be implemented in scripts/internal/detectstack first.",
  "mappings": {
    "always_load": [
      "plaesy.instructions.md",
      "plaesy-trim.instructions.md",
      "plaesy-graph.instructions.md",
      "tasks.instructions.md",
      "quality-gates.instructions.md",
      "error-recovery.instructions.md",
      "date-system.instructions.md",
      "assess-technical.instructions.md",
      "assess-design.instructions.md",
      "assess-business.instructions.md",
      "assess-financial.instructions.md",
      "assess-marketing.instructions.md",
      "assess-legal.instructions.md",
      "assess-management.instructions.md",
      "assess-product.instructions.md",
      "dimension-mapping.instructions.md",
      "error-recovery-predictive.instructions.md",
      "how-to-create-designmd.instructions.md",
      "output-validation.instructions.md",
      "universal-orchestrator.instructions.md"
    ],
    "frameworks": {
      "nextjs": {
        "file": "nextjs.instructions.md",
        "keywords": ["next.js", "nextjs", "app router", "server component", "next/", "@next/"],
        "patterns": ["import.*from ['\"](next/|@next/)"],
        "filenames": ["next.config.js", "next.config.mjs", "next.config.ts", "next.config.cjs"]
      },
      "nestjs": {
        "file": "nestjs.instructions.md",
        "keywords": ["nestjs", "nest.js", "@nestjs", "nest framework"],
        "patterns": ["import.*from ['\"]@nestjs/"]
      },
      "react": {
        "file": "reactjs.instructions.md",
        "keywords": ["react", "jsx", "tsx", "usestate", "useeffect", "react-dom", "react-scripts"],
        "patterns": ["import.*from ['\"]react"]
      },
      "react-native": {
        "file": "react-native.instructions.md",
        "keywords": ["react native", "react-native"],
        "patterns": ["import.*from ['\"]react-native"]
      },
      "angular": {
        "file": "angular.instructions.md",
        "keywords": ["angular", "@angular", "angular component"],
        "patterns": ["import.*from ['\"]@angular/"]
      },
      "flutter": {
        "file": "dart-n-flutter.instructions.md",
        "keywords": ["flutter", "widget", "stateless", "stateful"],
        "patterns": ["import ['\"]package:flutter/"]
      },
      "spring-boot": {
        "file": "springboot.instructions.md",
        "keywords": ["spring boot", "springboot", "spring framework", "@springboot", "spring-boot", "springframework"],
        "patterns": ["import.*springframework"]
      },
      "rails": {
        "file": "ruby-on-rails.instructions.md",
        "keywords": ["rails", "ruby on rails", "activerecord", "rack"],
        "patterns": ["require ['\"]rails"]
      },
      "powerpoint": {
        "file": "powerpoint.instructions.md",
        "keywords": ["python-pptx", "pptx", "powerpoint automation", "slide deck generation"],
        "patterns": ["import.*from ['\"]pptx", "from pptx import"],
        "extensions": [".ppt", ".pptx"]
      },
      "excel": {
        "file": "excel.instructions.md",
        "keywords": ["openpyxl", "xlsxwriter", "excel automation", "xlsx generation"],
        "patterns": ["import openpyxl", "import xlsxwriter", "from openpyxl import"],
        "extensions": [".xls", ".xlsx", ".xlsm"]
      },
      "word": {
        "file": "word.instructions.md",
        "keywords": ["python-docx", "docxtpl", "word automation", "docx generation"],
        "patterns": ["from docx import", "from docxtpl import"],
        "extensions": [".doc", ".docx"]
      },
      "static-site": {
        "file": "static-site.instructions.md",
        "keywords": ["eleventy", "11ty", "hugo static site", "jekyll", "static site generator"],
        "patterns": ["import.*from ['\"]astro"],
        "filenames": ["astro.config.mjs", "astro.config.ts", "eleventy.config.js", ".eleventy.js", "_config.yml", "hugo.toml", "hugo.yaml", "config.toml"]
      }
    },
    "languages": {
      "go": {
        "file": "go.instructions.md",
        "keywords": ["golang", "go lang", "go module"],
        "patterns": ["package main", "import \\("],
        "extensions": [".go"]
      },
      "java": {
        "file": "java.instructions.md",
        "keywords": ["java", "jvm", "maven", "gradle"],
        "patterns": ["public class.*\\{", "import java\\."],
        "extensions": [".java"]
      },
      "csharp": {
        "file": "csharp.instructions.md",
        "keywords": ["c#", "csharp", ".net", "dotnet", "asp.net"],
