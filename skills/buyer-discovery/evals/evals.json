{
  "skill": "buyer-discovery",
  "version": "1.0",
  "tests": [
    {
      "name": "track_outreach_funnel",
      "description": "Track outreach from contact to close with segment templates",
      "input": {
        "targets": [
          {"role": "Health Coach", "company": "Personal", "contact": "@coach1", "method": "IG DM", "segment": "coach"},
          {"role": "Founder", "company": "SupplementCo", "contact": "founder@supp.com", "method": "Email", "segment": "brand"}
        ],
        "templates": {
          "coach": "Hi {name}, saw your post about {topic}...",
          "brand": "Hi {name}, building tool for supplement brands..."
        }
      },
      "expected_output": {
        "tracker_created": true,
        "each_target_has_status": true,
        "template_per_segment": true
      },
      "assertions": [
        "tracker.length === 2",
        "tracker.every(t => t.status && t.segment && t.template_used)"
      ]
    },
    {
      "name": "record_interview_with_signals",
      "description": "Record interview with would_pay signal and tags",
      "input": {
        "date": "2026-11-03",
        "person": "Health coach, 22k IG, Jakarta",
        "questions": ["Workflow?", "Pain point?", "Price $29?"],
        "answers": ["ChatGPT+Canva+Later", "BPOM fear", "YES if reliable"],
        "would_pay": "YES",
        "price_point": 29,
        "tags": ["compliance_critical", "time_saving"]
      },
      "expected_output": {
        "record_saved": true,
        "would_pay_captured": true,
        "tags_captured": true
      },
      "assertions": [
        "record.would_pay === 'YES'",
        "record.price_point === 29",
        "record.tags.includes('compliance_critical')"
      ]
    },
    {
      "name": "count_signals_weighted",
      "description": "Count weighted would-pay signals with decision maker weighting",
      "input": {
        "conversations": [
          {"would_pay": "YES", "role": "founder", "budget_authority": true},
          {"would_pay": "YES", "role": "employee", "budget_authority": false},
          {"would_pay": "MAYBE", "role": "founder", "budget_authority": true},
          {"would_pay": "NO", "role": "founder", "budget_authority": true}
        ]
      },
      "expected_output": {
        "total": 4,
        "would_pay_yes": 1,
        "would_pay_maybe": 1,
        "weighted_score": 0.625
      },
      "assertions": [
        "signals.total === 4",
        "signals.would_pay_yes === 1",
        "signals.would_pay_maybe === 1",
        "signals.weighted_score === 0.625"
      ]
    },
    {
      "name": "segment_validation_matrix",
      "description": "Validate segment viability with kill/pivot signals",
      "input": {
        "segments": {
          "coach": {"conversations": 3, "would_pay_yes": 2, "would_pay_maybe": 1, "avg_price": 35, "tier_minimum": 29},
          "brand": {"conversations": 2, "would_pay_yes": 2, "would_pay_maybe": 0, "avg_price": 150, "tier_minimum": 99},
          "studio": {"conversations": 3, "would_pay_yes": 0, "would_pay_maybe": 1, "avg_price": 0, "tier_minimum": 49}
        }
      },
      "expected_output": {
        "coach": {"viable": true, "would_pay_rate": 0.67, "kill": false},
        "brand": {"viable": true, "would_pay_rate": 1.0, "kill": false},
        "studio": {"viable": false, "would_pay_rate": 0.0, "kill": true, "reason": "would_pay_rate < 30% with >=3 conversations"}
      },
      "assertions": [
        "matrix.coach.viable === true",
        "matrix.brand.viable === true",
        "matrix.studio.viable === false",
        "matrix.studio.kill === true",
        "matrix.studio.reason.includes('30%')"
      ]
    },
    {
      "name": "output_buyers_md_format",
      "description": "Output buyers.md in founder skill format with summary",
      "input": {
        "conversations": 5,
        "would_pay_yes": 4,
        "would_pay_maybe": 1,
        "records": []
      },
      "expected_output": {
        "format_matches": true,
        "summary_includes": ["conversation_count", "would_pay_count", "price_range", "top_insights"]
      },
      "assertions": [
        "output.includes('| Date | Person | Question | Answer | Would pay? |')",
        "output.includes('Real conversations: 5')",
        "output.includes('Would pay: 4')",
        "output.includes('top_insights')"
      ]
    }
  ]
}
