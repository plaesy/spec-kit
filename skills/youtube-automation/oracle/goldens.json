{
  "skill": "youtube-automation",
  "version": "1.0",
  "engine": "python",
  "goldens": [
    {
      "name": "research_agent_sources",
      "description": "Research agent produces brief with >=3 sources from multiple platforms",
      "input": {"topic": "AI tools for developers", "niche": "tech education"},
      "expected_output": {
        "sources_count": {"min": 3},
        "has_trends": true,
        "has_wikipedia": true,
        "has_arxiv": true
      }
    },
    {
      "name": "fact_check_grounding",
      "description": "Fact-check agent grounds all claims or marks as assumption",
      "input": {
        "claims": ["AI can write code", "GPT-4 released in 2023", "AI will replace all developers"],
        "sources": ["wikipedia", "arxiv"]
      },
      "expected_output": {
        "all_grounded_or_assumed": true,
        "verified_claims": 2,
        "assumptions_marked": 1
      }
    },
    {
      "name": "script_structure_long_form",
      "description": "Script agent produces hook, body, CTA, chapters for long-form",
      "input": {"research_brief": "...", "format": "long"},
      "expected_output": {
        "has_hook": true,
        "has_body": true,
        "has_cta": true,
        "chapters_count": {"min": 4}
      }
    },
    {
      "name": "visuals_fail_soft_chain",
      "description": "Visuals agent tries Pexels -> Pixabay -> NASA -> Openverse -> AI",
      "input": {"queries": ["AI coding", "developer tools"], "format": "long"},
      "expected_output": {
        "visuals_count": {"min": 5},
        "credits_included": true,
        "fallback_chain": ["pexels", "pixabay", "nasa", "openverse", "pollinations"],
        "all_have_credits": true
      }
    },
    {
      "name": "voice_srt_sync",
      "description": "Voice agent produces SRT with sync < 500ms drift",
      "input": {"script": "Test script for voice", "voice": "en-US-AriaNeural"},
      "expected_output": {
        "srt_generated": true,
        "sync_drift_ms": {"max": 500}
      }
    },
    {
      "name": "render_validity_long_form",
      "description": "Render agent produces valid MP4 16:9 with watermark",
      "input": {"format": "long", "target_duration_sec": 700},
      "expected_output": {
        "mp4_valid": true,
        "duration_ratio": {"min": 0.9, "max": 1.1},
        "has_watermark": true,
        "aspect_ratio": "16:9",
        "resolution": "1920x1080"
      }
    },
    {
      "name": "render_validity_shorts",
      "description": "Render agent produces valid MP4 9:16 for Shorts",
      "input": {"format": "short", "target_duration_sec": 45},
      "expected_output": {
        "mp4_valid": true,
        "duration_ratio": {"min": 0.9, "max": 1.1},
        "has_watermark": true,
        "aspect_ratio": "9:16",
        "resolution": "1080x1920"
      }
    },
    {
      "name": "findability_score_pass",
      "description": "Review agent calculates 11-point findability score >= 80",
      "input": {
        "title": "How AI Tools Save Developers 10 Hours/Week",
        "description": "In this video we cover...",
        "tags": ["AI", "coding", "productivity"],
        "has_chapters": true,
        "has_cta": true
      },
      "expected_output": {
        "score": {"min": 80},
        "checks_passed": {"min": 9},
        "checks_total": 11
      }
    },
    {
      "name": "thumbnail_generation_4_styles",
      "description": "Thumbnail designer produces 4 styles in correct ratio < 2MB",
      "input": {"title": "Test Video", "format": "long"},
      "expected_output": {
        "styles_count": 4,
        "styles": ["Impact", "Cinematic", "Split", "Studio"],
        "all_under_2mb": true,
        "aspect_ratio": "16:9"
      }
    },
    {
      "name": "fail_soft_api_chain",
      "description": "API chain falls back: Gemini -> Groq -> OpenRouter -> Pollinations",
      "input": {"primary_fails": true, "backup_fails": true, "keyless_works": true},
      "expected_output": {
        "completed": true,
        "fallback_used": true,
        "fallback_chain_min": 2
      }
    },
    {
      "name": "output_structure_complete",
      "description": "All output files created in library structure",
      "input": {"video_id": "test-123"},
      "expected_output": {
        "files_exist": ["video.mp4", "thumbnail.jpg", "captions.srt", "script.md", "metadata.json", "findability_report.md"],
        "library_structure": "output/library/test-123/"
      }
    }
  ]
}