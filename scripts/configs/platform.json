{
  "version": "1.0",
  "description": "Platform detection and file mapping for Plaesy Spec-Kit",
  "plaesy": {
    "base_directory": ".plaesy",
    "core_directories": [
      "memory",
      "roles",
      "analysis",
      "tasks",
      "scripts"
    ],
    "project_directories": [
      "docs",
      "specs"
    ],
    "mapping": {
      "core": {
        "value": "instructions/agents.instructions.md"
      },
      "memory": {
        "value": "memory/*",
        "excludes": []
      },
      "roles": {
        "value": "roles/*",
        "excludes": [],
        "description": "Chatmodes copied to .plaesy/roles (platform-agnostic development storage)"
      },
      "tasks": {
        "value": "tasks/*",
        "excludes": [],
        "description": "Task management system - universal across all platforms"
      },
      "instructions": {
        "value": "instructions/*",
        "excludes": [
          "agents.instructions.md"
        ]
      },
      "prompts": {
        "value": "prompts/*",
        "excludes": []
      },
      "chatmodes": {
        "value": "chatmodes/*",
        "excludes": []
      },
      "templates": {
        "value": "templates/*",
        "excludes": []
      },
      "checklists": {
        "value": "checklists/*",
        "excludes": []
      },
      "scripts": {
        "value": "scripts/*",
        "excludes": []
      }
    }
  },
  "platforms": {
    "claude_code": {
      "name": "Claude Code",
      "provider": "Anthropic",
      "category": "cli_tools",
      "detection": [
        ".claude/settings.local.json",
        ".claude/commands"
      ],
      "mapping": {
        "core": "CLAUDE.md",
        "instructions": ".claude/instructions",
        "prompts": ".claude/commands",
        "chatmodes": ".claude/roles"
      }
    },
    "cursor_ai": {
      "name": "Cursor AI",
      "provider": "Cursor",
      "category": "ide_tools",
      "detection": [
        ".cursorrules",
        ".cursor/rules",
        ".cursor"
      ],
      "mapping": {
        "core": ".cursor/rules/plaesy.mdc",
        "instructions": ".cursor/instructions",
        "prompts": ".cursor/rules"
      }
    },
    "github_copilot": {
